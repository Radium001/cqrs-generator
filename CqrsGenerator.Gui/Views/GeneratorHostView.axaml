<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:CqrsGenerator.Gui.ViewModels"
             xmlns:views="using:CqrsGenerator.Gui.Views"
             x:Class="CqrsGenerator.Gui.Views.GeneratorHostView"
             x:DataType="viewModels:GeneratorHostViewModel">
  <UserControl.DataTemplates>
    <views:ViewLocator />
  </UserControl.DataTemplates>

  <Border Padding="20"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="16">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12"
            IsVisible="{Binding HasActiveAction}">
        <TextBlock Text="{Binding ActiveBreadcrumbText}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Top">
          <Button Content="Done"
                  Command="{Binding Stack.CompleteEmbeddedCommand}"
                  IsVisible="{Binding HasEmbeddedSession}" />
          <Button Content="Cancel"
                  Command="{Binding Stack.CancelEmbeddedCommand}"
                  IsVisible="{Binding HasEmbeddedSession}" />
          <Button Content="Close"
                  Command="{Binding Stack.CloseRootCommand}"
                  IsVisible="{Binding HasActiveAction}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1"
              Background="Transparent"
              IsVisible="{Binding IsLauncherVisible}">
        <views:ActionLauncherView DataContext="{Binding ActionLauncher}" />
      </Border>

      <Border Grid.Row="1"
              IsVisible="{Binding HasActiveAction}">
        <ContentControl Content="{Binding ActiveSession}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
