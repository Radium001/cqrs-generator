<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:CqrsGenerator.Gui.ViewModels"
             x:Class="CqrsGenerator.Gui.Views.MainMenuView"
             x:DataType="viewModels:MainMenuViewModel">
  <Border Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="12">
      <Menu>
        <MenuItem Header="_Project">
          <MenuItem Header="_Open Project"
                    Command="{Binding OpenProjectCommand}" />
          <MenuItem Header="_Rescan"
                    Command="{Binding RescanProjectCommand}"
                    IsEnabled="{Binding CanRescan}" />
        </MenuItem>

        <MenuItem Header="_Settings">
          <MenuItem Header="_Theme">
            <MenuItem Header="_System"
                      Command="{Binding SetSystemThemeCommand}">
              <MenuItem.Icon>
                <TextBlock Text="✓"
                           IsVisible="{Binding IsSystemThemeSelected}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Light"
                      Command="{Binding SetLightThemeCommand}">
              <MenuItem.Icon>
                <TextBlock Text="✓"
                           IsVisible="{Binding IsLightThemeSelected}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Dark"
                      Command="{Binding SetDarkThemeCommand}">
              <MenuItem.Icon>
                <TextBlock Text="✓"
                           IsVisible="{Binding IsDarkThemeSelected}" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>
          <MenuItem Header="_Updates">
            <MenuItem Header="{Binding Updates.VersionSummary}"
                      IsEnabled="False" />
            <Separator />
            <MenuItem Header="_Check for updates"
                      Command="{Binding Updates.CheckForUpdatesCommand}" />
            <MenuItem Header="_Download and restart"
                      Command="{Binding Updates.DownloadAndInstallUpdateCommand}" />
          </MenuItem>
        </MenuItem>
      </Menu>

      <StackPanel Grid.Column="1"
                  Margin="0,6,12,6"
                  HorizontalAlignment="Right"
                  Spacing="2">
        <TextBlock HorizontalAlignment="Right"
                   Text="{Binding TargetRootPath}"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="6">
          <TextBlock Text="{Binding Updates.BadgeText}"
                     IsVisible="{Binding Updates.IsLatest}"
                     Foreground="{DynamicResource TextCreateBrush}"
                     FontSize="12" />
          <TextBlock Text="{Binding Updates.BadgeText}"
                     IsVisible="{Binding Updates.IsUpdateAvailable}"
                     Foreground="{DynamicResource TextUpdateBrush}"
                     FontSize="12" />
          <TextBlock Text="{Binding Updates.BadgeText}"
                     IsVisible="{Binding Updates.IsDownloadingStatus}"
                     Foreground="{DynamicResource TextAccentBrush}"
                     FontSize="12" />
          <TextBlock Text="{Binding Updates.BadgeText}"
                     IsVisible="{Binding Updates.IsStatusMuted}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
