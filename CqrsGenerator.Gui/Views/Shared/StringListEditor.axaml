<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:CqrsGenerator.Gui.ViewModels"
             x:Class="CqrsGenerator.Gui.Views.Shared.StringListEditor"
             x:DataType="viewModels:StringListEditorViewModel">
  <Grid RowDefinitions="Auto,*"
        RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="12">
      <TextBlock Text="{Binding Title}"
                 FontWeight="SemiBold" />
      <TextBlock Grid.Column="1"
                 Text="{Binding Entries.Count, StringFormat='Count: {0}'}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 VerticalAlignment="Center" />
      <Button Grid.Column="2"
              Content="{Binding AddButtonText}"
              Command="{Binding AddEntryCommand}" />
    </Grid>

    <ItemsControl Grid.Row="1"
                  ItemsSource="{Binding Entries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="viewModels:StringEntryViewModel">
          <Grid Margin="0,0,0,8"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <TextBox Text="{Binding Value, Mode=TwoWay}"
                     Watermark="{Binding $parent[ItemsControl].((viewModels:StringListEditorViewModel)DataContext).ValueWatermark}" />
            <Button Grid.Column="1"
                    Command="{Binding $parent[ItemsControl].((viewModels:StringListEditorViewModel)DataContext).RemoveEntryCommand}"
                    CommandParameter="{Binding}"
                    Width="32"
                    Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Remove">
              <PathIcon Data="{StaticResource DeleteIcon}"
                        Width="16"
                        Height="16" />
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
