<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:CqrsGenerator.Gui.ViewModels"
             xmlns:shared="using:CqrsGenerator.Gui.Views.Shared"
             x:Class="CqrsGenerator.Gui.Views.Shared.DependencyPicker"
             x:DataType="viewModels:DependencyPickerViewModel">
  <StackPanel Spacing="8">
    <TextBlock Text="Handler Dependencies"
               FontWeight="SemiBold" />

    <shared:MultiSelectListPicker DataContext="{Binding Picker}" />

    <Button Command="{Binding CreateRepositoryCommand}"
            IsVisible="{Binding HasCreateRepository}"
            HorizontalAlignment="Left">
      + Create repository
    </Button>
  </StackPanel>
</UserControl>
