<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CqrsGenerator.Gui.ViewModels"
             x:Class="CqrsGenerator.Gui.Views.Shared.ItemChip"
             x:DataType="vm:ItemChipViewModel">
  <Border Padding="8,4"
          CornerRadius="6"
          Background="{DynamicResource ChipBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1">
    <Grid ColumnDefinitions="Auto,Auto,Auto"
          ColumnSpacing="8">
      <TextBlock Text="{Binding DisplayText}"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <Button Grid.Column="1"
              Command="{Binding EditCommand}"
              IsVisible="{Binding HasEdit}"
              Focusable="False"
              Padding="4,0"
              Background="Transparent"
              BorderThickness="0"
              Foreground="{DynamicResource TextMutedBrush}"
              ToolTip.Tip="Edit">
        <PathIcon Data="{StaticResource EditIcon}" Width="14" Height="14" />
      </Button>
      <Button Grid.Column="2"
              Command="{Binding DeleteCommand}"
              IsVisible="{Binding HasDelete}"
              Focusable="False"
              Padding="4,0"
              Background="Transparent"
              BorderThickness="0"
              Foreground="{DynamicResource TextMutedBrush}"
              ToolTip.Tip="Remove">
        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" />
      </Button>
    </Grid>
  </Border>
</UserControl>
