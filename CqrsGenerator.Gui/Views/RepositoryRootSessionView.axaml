<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CqrsGenerator.Gui.ViewModels.Generators"
             xmlns:viewModels="using:CqrsGenerator.Gui.ViewModels"
             xmlns:shared="using:CqrsGenerator.Gui.Views.Shared"
             x:Class="CqrsGenerator.Gui.Views.RepositoryRootSessionView"
             x:DataType="vm:RepositoryRootSessionViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <Border Padding="14"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="16">
          <Grid RowDefinitions="Auto,Auto,Auto"
                RowSpacing="8">
            <TextBlock Text="Entity"
                       FontWeight="SemiBold" />
            <shared:WrappedListPicker Grid.Row="1"
                                      DataContext="{Binding EntityPicker}" />
            <Button Grid.Row="2"
                    Content="Create Entity"
                    Command="{Binding OpenCreateEntityCommand}"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding ShowCreateEntityButton}" />
          </Grid>

          <Grid Grid.Column="1"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
            <TextBlock Text="Options"
                       FontWeight="SemiBold" />
            <CheckBox Grid.Row="1"
                      Content="Register in DI"
                      IsChecked="{Binding AddDependencyInjectionRegistration, Mode=TwoWay}" />
          </Grid>
        </Grid>
      </Border>

      <Border Padding="14"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <StackPanel Spacing="12">
          <TextBlock Text="Standard Methods"
                     FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding MethodPresets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:RepositoryMethodPresetItemViewModel">
                <CheckBox Content="{Binding Name}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Padding="14"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
            <TextBlock Text="Custom Methods"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="Add Method"
                    Command="{Binding AddCustomMethodCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding CustomMethods}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:RepositoryMethodEditorViewModel">
                <Border Margin="0,0,0,8"
                        Padding="12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*,Auto"
                          ColumnSpacing="8">
                      <TextBox Text="{Binding ReturnType, Mode=TwoWay}"
                               Watermark="Task&lt;User&gt;" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Name, Mode=TwoWay}"
                               Watermark="Method name" />
                      <Button Grid.Column="2"
                              Command="{Binding RemoveMethodCommand}"
                              CommandParameter="{Binding}"
                              Width="32"
                              Height="32"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip.Tip="Remove">
                        <PathIcon Data="{StaticResource DeleteIcon}"
                                  Width="16"
                                  Height="16" />
                      </Button>
                    </Grid>
                    <shared:PropertyEntryListEditor DataContext="{Binding ParameterEditor}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
