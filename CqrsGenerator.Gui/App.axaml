      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="HeroForegroundBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="HeroSecondaryForegroundBrush" Color="#334155" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PanelMutedBackgroundBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="PanelAccentBackgroundBrush" Color="#EFF6FF" />
          <SolidColorBrush x:Key="PanelWarningBackgroundBrush" Color="#FFF7ED" />
          <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1" />
          <SolidColorBrush x:Key="SoftBorderBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#BFDBFE" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#FED7AA" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
          <SolidColorBrush x:Key="TextAccentBrush" Color="#1D4ED8" />
          <SolidColorBrush x:Key="TextAccentSecondaryBrush" Color="#1E3A8A" />
          <SolidColorBrush x:Key="TextCreateBrush" Color="#15803D" />
          <SolidColorBrush x:Key="TextUpdateBrush" Color="#B45309" />
          <SolidColorBrush x:Key="TextConflictBrush" Color="#DC2626" />
          <SolidColorBrush x:Key="TextWarningBrush" Color="#9A3412" />
          <SolidColorBrush x:Key="TextWarningSecondaryBrush" Color="#7C2D12" />
          <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#A7F3D0" />
          <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#FEE2E2" />
          <SolidColorBrush x:Key="DiffModifiedBackgroundBrush" Color="#FED7AA" />
          <SolidColorBrush x:Key="CodeSelectionBackgroundBrush" Color="#BFDBFE" />
          <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="SplitterBrush" Color="#CBD5E1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111111" />
          <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#1C1C1C" />
          <SolidColorBrush x:Key="HeroForegroundBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="HeroSecondaryForegroundBrush" Color="#D4D4D8" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1C1C" />
          <SolidColorBrush x:Key="PanelMutedBackgroundBrush" Color="#252525" />
          <SolidColorBrush x:Key="PanelAccentBackgroundBrush" Color="#2A2A2A" />
          <SolidColorBrush x:Key="PanelWarningBackgroundBrush" Color="#431407" />
          <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46" />
          <SolidColorBrush x:Key="SoftBorderBrush" Color="#2A2A2A" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#52525B" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#C2410C" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E5E7EB" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D4D4D8" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA" />
          <SolidColorBrush x:Key="TextAccentBrush" Color="#E4E4E7" />
          <SolidColorBrush x:Key="TextAccentSecondaryBrush" Color="#D4D4D8" />
          <SolidColorBrush x:Key="TextCreateBrush" Color="#86EFAC" />
          <SolidColorBrush x:Key="TextUpdateBrush" Color="#FBBF24" />
          <SolidColorBrush x:Key="TextConflictBrush" Color="#FB7185" />
          <SolidColorBrush x:Key="TextWarningBrush" Color="#FDBA74" />
          <SolidColorBrush x:Key="TextWarningSecondaryBrush" Color="#FED7AA" />
          <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#14532D" />
          <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#450A0A" />
          <SolidColorBrush x:Key="DiffModifiedBackgroundBrush" Color="#78350F" />
          <SolidColorBrush x:Key="CodeSelectionBackgroundBrush" Color="#1E3A8A" />
          <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#3F3F46" />
          <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#3F3F46" />
          <SolidColorBrush x:Key="SplitterBrush" Color="#3F3F46" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light"
                               Accent="#6B7280"
                               RegionColor="#FFFFFF" />
        <ColorPaletteResources x:Key="Dark"
                               Accent="#9CA3AF"
                               RegionColor="#1F1F1F" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource PanelMutedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
