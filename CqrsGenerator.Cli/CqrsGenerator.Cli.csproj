<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cqrs-gen</ToolCommandName>
    <PackageId>CqrsGenerator.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>cqrs-generator</Authors>
    <Description>CQRS/MediatR code generator for the project conventions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CqrsGenerator.Core\CqrsGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodePunk.Highlight" Version="0.3.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
  </ItemGroup>

</Project>
